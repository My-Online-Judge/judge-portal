# Optional. Unset/empty = same-origin "/api/v1" (served by the HTTPS edge in production).
# Set it only to point the built app at a different API origin.
# VITE_API_BASE_URL=/api/v1

# Dev server only: where `npm run dev` proxies /api (the edge; its certificate is
# issued by the private OJ CA, so the proxy does not verify it). Default: https://localhost
# VITE_DEV_PROXY_TARGET=https://localhost
